FROM rust:1.88-bookworm AS build

WORKDIR /source
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --locked -p worktree-zero

FROM oven/bun:1.3.14 AS bun

FROM node:22-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends btrfs-progs git jq lsof python3 util-linux \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /source/target/debug/wt0 /usr/local/bin/wt0
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY tests/bench_agent_runtime.sh /usr/local/lib/wt0/bench-agent-runtime
COPY tests/bench_builders_stack.sh /usr/local/lib/wt0/bench-builders-stack
COPY tests/bench_migration.sh /usr/local/lib/wt0/bench-migration
COPY tests/bench_scaling.sh /usr/local/lib/wt0/bench-scaling

ENTRYPOINT ["bash", "-ceu"]
